# Copia este archivo como secrets.env y completa los valores.
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
# secrets.env está en .gitignore: nunca se sube a GitHub.

# Token de acceso personal de Canvas (aulavirtual → Cuenta → Configuración → Nuevo token de acceso).
CANVAS_TOKEN=


# Solo con Telegram encendido ([channels] telegram = true en config.toml). Con Telegram apagado, Vinci usa
# WHATSAPP_CAPTAIN (más abajo) y estas dos pueden quedar vacías.
# Token del bot de Vinci que te dio @BotFather (un bot NUEVO, solo para Vinci).
TELEGRAM_BOT_TOKEN=

# Tu ID numérico de Telegram (te lo da @userinfobot). El bot solo te responde a ti.
TELEGRAM_USER_ID=

# Los tokens de los bots de materia (TELEGRAM_BOT_TOKEN_<CÓDIGO>, ej. TELEGRAM_BOT_TOKEN_ESTG1034)
# no se escriben a mano: Vinci los agrega aquí cuando crea cada bot desde el chat. Un filtro atrapa
# el token antes de que llegue al modelo, lo guarda aquí y borra del chat el mensaje que lo traía.

# Opcional: Vinci en WhatsApp (con un número aparte, ver «Vinci en WhatsApp» en el README).
# Tu número de WhatsApp con el código de país, sin «+» y sin el 0 inicial (en Ecuador: 5939…).
# Solo tú manejas Vinci desde WhatsApp; tus amigos los agregas desde el chat con /amigo agregar.
WHATSAPP_CAPTAIN=
# Opcional: el relé de Vinci en Cloudflare Workers (relay/, ver «El relé» en el README). Con él, la página del token y
# el panel de entregas abiertos desde WhatsApp le mandan a Vinci lo que haces ahí, sin pegar nada en el chat.
# El botón «🎓 Conectar Académico» lo necesita (Telegram y WhatsApp): por ahí la página recibe el CAPTCHA.
WHATSAPP_RELAY_URL=
WHATSAPP_RELAY_TOKEN=
# Opcional: la clave del arte cifrado del álbum (docs/album/art/), las cartas con caras de personas reales. No la
# escribes tú: la crea `uv run scripts/album_card.py key` en la PC donde haces las cartas; pásala a Coolify con el
# mismo nombre. Sin ella, esas cartas muestran sus iniciales.
ALBUM_ART_KEY=
# Opcional: la clave de la sección TAWS del álbum (su catálogo y su arte, docs/album/clubs/). La crea
# `uv run scripts/album_card.py key --club taws`; pásala a Coolify con el mismo nombre. Sin ella no hay sección TAWS.
ALBUM_TAWS_KEY=
# Opcional: la clave del enlace al panel de administración para quien no está en tu red de Tailscale
# (docs/guia/panel.md). No la escribes tú: la crea `.venv/bin/espol-bot panel --nueva-clave`.
PANEL_KEY=
# Opcional: la clave con la que un agente en tu PC (`vinci-check remote`) lee los logs, corre comandos y edita
# archivos del contenedor (docs/guia/panel.md, «El agente desde tu PC»). Es acceso total: no la escribes tú, la crea
# `espol-bot panel --clave-agente`, y `--quitar-agente` la borra.
AGENT_KEY=
# Opcional: entrar al panel con Google (docs/guia/panel.md, «Entrar con Google»). Solo la cuenta de
# PANEL_GOOGLE_EMAIL entra, y el enlace con PANEL_KEY deja de abrirlo. No los escribes tú: los pone
# `espol-bot panel --google tu@gmail.com <id>.apps.googleusercontent.com`, que también crea PANEL_SESSION_SECRET.
PANEL_GOOGLE_EMAIL=
PANEL_GOOGLE_CLIENT_ID=
PANEL_SESSION_SECRET=
